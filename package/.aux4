{
  "scope": "community",
  "name": "stripe",
  "version": "1.1.2",
  "description": "Stripe CLI and API communication for live and sandbox environments",
  "license": "MIT",
  "tags": [
    "stripe",
    "payments",
    "billing",
    "revenue",
    "subscriptions"
  ],
  "system": [
    [
      "test:stripe --version",
      "brew:stripe/stripe-cli/stripe"
    ],
    [
      "test:jq --version",
      "brew:jq",
      "apt:jq",
      "apk:jq"
    ],
    [
      "test:node --version",
      "brew:node",
      "apt:nodejs",
      "dnf:nodejs",
      "apk:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "stripe",
          "execute": [
            "profile:stripe"
          ],
          "help": {
            "text": "Stripe management commands"
          }
        }
      ]
    },
    {
      "name": "stripe",
      "commands": [
        {
          "name": "login",
          "execute": [
            "json:stripe login",
            "set:browserUrl=${response.browser_url}",
            "set:code=${response.verification_code}",
            "set:nextStep=${response.next_step}",
            "log:",
            "log:Open this URL in your browser:",
            "log:  ${browserUrl}",
            "log:",
            "log:Verification code: ${code}",
            "log:",
            "confirm:Press Enter after confirming in browser",
            "${nextStep}",
            "log:Logged in successfully"
          ],
          "help": {
            "text": "Authenticate with Stripe"
          }
        },
        {
          "name": "products",
          "execute": [
            "profile:stripe:products"
          ],
          "help": {
            "text": "Manage Stripe products"
          }
        },
        {
          "name": "prices",
          "execute": [
            "profile:stripe:prices"
          ],
          "help": {
            "text": "Manage Stripe prices"
          }
        },
        {
          "name": "links",
          "execute": [
            "profile:stripe:links"
          ],
          "help": {
            "text": "Manage payment links"
          }
        },
        {
          "name": "subscriptions",
          "execute": [
            "profile:stripe:subscriptions"
          ],
          "help": {
            "text": "Manage subscriptions"
          }
        },
        {
          "name": "customers",
          "execute": [
            "profile:stripe:customers"
          ],
          "help": {
            "text": "Manage customers"
          }
        },
        {
          "name": "webhooks",
          "execute": [
            "profile:stripe:webhooks"
          ],
          "help": {
            "text": "Manage webhooks"
          }
        },
        {
          "name": "revenue",
          "execute": [
            "profile:stripe:revenue"
          ],
          "help": {
            "text": "Revenue monitoring and reports"
          }
        },
        {
          "name": "api",
          "execute": [
            "profile:stripe:api"
          ],
          "help": {
            "text": "Call the Stripe API"
          }
        },
        {
          "name": "billing",
          "execute": [
            "profile:stripe:billing"
          ],
          "help": {
            "text": "Manage Stripe Billing meters and usage events"
          }
        }
      ]
    },
    {
      "name": "stripe:products",
      "commands": [
        {
          "name": "list",
          "execute": [
            "stripe products list --limit ${limit} --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List all products",
            "variables": [
              {
                "name": "limit",
                "text": "Number of products to list",
                "default": "10"
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "stripe products retrieve ${productId} --color off"
          ],
          "help": {
            "text": "Get a product by ID",
            "variables": [
              {
                "name": "productId",
                "text": "Product ID",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "create",
          "execute": [
            "stripe products create --name values(name) --description values(description)"
          ],
          "help": {
            "text": "Create a new product",
            "variables": [
              {
                "name": "name",
                "text": "Product name"
              },
              {
                "name": "description",
                "text": "Product description",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "update",
          "execute": [
            "stripe products update ${productId} --name values(name)"
          ],
          "help": {
            "text": "Update a product",
            "variables": [
              {
                "name": "productId",
                "text": "Product ID",
                "arg": true
              },
              {
                "name": "name",
                "text": "New product name"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:prices",
      "commands": [
        {
          "name": "list",
          "execute": [
            "stripe prices list --product ${productId} --limit ${limit} --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List prices for a product",
            "variables": [
              {
                "name": "productId",
                "text": "Product ID",
                "arg": true
              },
              {
                "name": "limit",
                "text": "Number of prices to list",
                "default": "10"
              }
            ]
          }
        },
        {
          "name": "create",
          "execute": [
            "stripe prices create --product ${productId} --unit-amount ${amount} --currency ${currency} -d \"recurring[interval]=${interval}\""
          ],
          "help": {
            "text": "Create a recurring price",
            "variables": [
              {
                "name": "productId",
                "text": "Product ID"
              },
              {
                "name": "amount",
                "text": "Amount in cents (e.g., 500 for $5.00)"
              },
              {
                "name": "currency",
                "text": "Currency code",
                "default": "usd"
              },
              {
                "name": "interval",
                "text": "Billing interval",
                "default": "month",
                "options": [
                  "month",
                  "year"
                ]
              }
            ]
          }
        },
        {
          "name": "create-metered",
          "execute": [
            "stripe prices create --product values(productId) --unit-amount values(amount) --currency values(currency) --recurring.interval values(interval) --recurring.usage-type metered --recurring.meter values(meterId)"
          ],
          "help": {
            "text": "Create a recurring metered price for a Stripe Billing meter",
            "variables": [
              {
                "name": "productId",
                "text": "Stripe product ID",
                "arg": true
              },
              {
                "name": "meterId",
                "text": "Stripe Billing Meter ID"
              },
              {
                "name": "amount",
                "text": "Amount in cents per meter unit"
              },
              {
                "name": "currency",
                "text": "Currency code",
                "default": "usd"
              },
              {
                "name": "interval",
                "text": "Billing interval",
                "default": "month",
                "options": [
                  "month",
                  "year"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:links",
      "commands": [
        {
          "name": "list",
          "execute": [
            "stripe payment_links list --limit ${limit} --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List payment links",
            "variables": [
              {
                "name": "limit",
                "text": "Number of links to list",
                "default": "10"
              }
            ]
          }
        },
        {
          "name": "create",
          "execute": [
            "stripe payment_links create -d \"line_items[0][price]=${priceId}\" -d \"line_items[0][quantity]=1\""
          ],
          "help": {
            "text": "Create a payment link for a price",
            "variables": [
              {
                "name": "priceId",
                "text": "Price ID",
                "arg": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:subscriptions",
      "commands": [
        {
          "name": "list",
          "execute": [
            "stripe subscriptions list --limit ${limit} --status ${status} --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List subscriptions",
            "variables": [
              {
                "name": "limit",
                "text": "Number of subscriptions to list",
                "default": "10"
              },
              {
                "name": "status",
                "text": "Filter by status",
                "default": "active",
                "options": [
                  "active",
                  "past_due",
                  "canceled",
                  "all"
                ]
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "stripe subscriptions retrieve ${subscriptionId} --color off"
          ],
          "help": {
            "text": "Get subscription details",
            "variables": [
              {
                "name": "subscriptionId",
                "text": "Subscription ID",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "cancel",
          "execute": [
            "confirm:Cancel subscription ${subscriptionId}?",
            "stripe subscriptions cancel ${subscriptionId} --prorate"
          ],
          "help": {
            "text": "Cancel a subscription",
            "variables": [
              {
                "name": "subscriptionId",
                "text": "Subscription ID",
                "arg": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:customers",
      "commands": [
        {
          "name": "list",
          "execute": [
            "stripe customers list --limit ${limit} --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List customers",
            "variables": [
              {
                "name": "limit",
                "text": "Number of customers to list",
                "default": "10"
              }
            ]
          }
        },
        {
          "name": "search",
          "execute": [
            "stripe customers search --query \"email:'${email}'\" 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "Search customers by email",
            "variables": [
              {
                "name": "email",
                "text": "Email to search",
                "arg": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:webhooks",
      "commands": [
        {
          "name": "listen",
          "execute": [
            "stripe listen --forward-to ${forwardTo}"
          ],
          "help": {
            "text": "Forward webhook events to a local endpoint",
            "variables": [
              {
                "name": "forwardTo",
                "text": "Local endpoint URL",
                "default": "http://localhost:3001/v1/billing/events"
              }
            ]
          }
        },
        {
          "name": "endpoints",
          "execute": [
            "stripe webhook_endpoints list --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List configured webhook endpoints"
          }
        },
        {
          "name": "trigger",
          "execute": [
            "stripe trigger ${event}"
          ],
          "help": {
            "text": "Trigger a test webhook event",
            "variables": [
              {
                "name": "event",
                "text": "Event type to trigger",
                "arg": true,
                "options": [
                  "checkout.session.completed",
                  "customer.subscription.created",
                  "customer.subscription.updated",
                  "customer.subscription.deleted",
                  "invoice.payment_succeeded",
                  "invoice.payment_failed",
                  "charge.refunded"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:revenue",
      "commands": [
        {
          "name": "summary",
          "execute": [
            "nout:stripe subscriptions list --status active --limit 100 -d value(expand) --color off",
            "set:subscriptions=${response}",
            "node ${packageDir}/lib/stripe.mjs revenue-summary values(subscriptions)"
          ],
          "help": {
            "text": "Show revenue summary (MRR, ARR, active subscribers)",
            "variables": [
              {
                "name": "subscriptions",
                "text": "Internal subscription response",
                "default": "",
                "private": true
              },
              {
                "name": "expand",
                "text": "Internal subscription expansion",
                "default": "expand[]=data.plan",
                "private": true
              }
            ]
          }
        },
        {
          "name": "charges",
          "execute": [
            "stripe charges list --limit ${limit} -d \"created[gte]=${since}\" 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List recent charges",
            "variables": [
              {
                "name": "limit",
                "text": "Number of charges to list",
                "default": "25"
              },
              {
                "name": "since",
                "text": "Unix timestamp to filter from (default: 30 days ago)",
                "default": "!date -v-30d +%s"
              }
            ]
          }
        },
        {
          "name": "invoices",
          "execute": [
            "stripe invoices list --limit ${limit} --status ${status} --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List invoices",
            "variables": [
              {
                "name": "limit",
                "text": "Number of invoices to list",
                "default": "25"
              },
              {
                "name": "status",
                "text": "Filter by status",
                "default": "paid",
                "options": [
                  "paid",
                  "open",
                  "void",
                  "uncollectible"
                ]
              }
            ]
          }
        },
        {
          "name": "balance",
          "execute": [
            "stripe balance retrieve --color off"
          ],
          "help": {
            "text": "Show current Stripe balance"
          }
        },
        {
          "name": "payouts",
          "execute": [
            "stripe payouts list --limit ${limit} --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List recent payouts",
            "variables": [
              {
                "name": "limit",
                "text": "Number of payouts to list",
                "default": "10"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:api",
      "commands": [
        {
          "name": "request",
          "execute": [
            "stdin:node ${packageDir}/lib/stripe.mjs api-request"
          ],
          "help": {
            "text": "Send a JSON-described HTTP request to Stripe"
          }
        }
      ]
    },
    {
      "name": "stripe:billing",
      "commands": [
        {
          "name": "meters",
          "execute": [
            "profile:stripe:billing:meters"
          ],
          "help": {
            "text": "Manage Billing Meters"
          }
        },
        {
          "name": "meter-events",
          "execute": [
            "profile:stripe:billing:meter-events"
          ],
          "help": {
            "text": "Record a Billing Meter event"
          }
        }
      ]
    },
    {
      "name": "stripe:billing:meters",
      "commands": [
        {
          "name": "list",
          "execute": [
            "stripe billing meters list --limit values(limit) --color off 2>/dev/null | jq .data"
          ],
          "help": {
            "text": "List Billing Meters",
            "variables": [
              {
                "name": "limit",
                "text": "Maximum meters to return",
                "default": "100"
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "stripe billing meters retrieve values(meterId) --color off"
          ],
          "help": {
            "text": "Retrieve a Billing Meter",
            "variables": [
              {
                "name": "meterId",
                "text": "Billing Meter ID",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "create",
          "execute": [
            "stripe billing meters create --display-name values(displayName) --event-name values(eventName) --default-aggregation.formula values(formula) --customer-mapping.type by_id --customer-mapping.event-payload-key values(customerKey) --value-settings.event-payload-key values(valueKey) --confirm --color off"
          ],
          "help": {
            "text": "Create a Billing Meter",
            "variables": [
              {
                "name": "displayName",
                "text": "Meter name shown in Stripe",
                "arg": true
              },
              {
                "name": "eventName",
                "text": "Stable meter event name"
              },
              {
                "name": "formula",
                "text": "Aggregation formula",
                "default": "sum",
                "options": [
                  "sum",
                  "count",
                  "last"
                ]
              },
              {
                "name": "customerKey",
                "text": "Event payload key containing the Stripe customer ID",
                "default": "stripe_customer_id"
              },
              {
                "name": "valueKey",
                "text": "Event payload key containing the measured value",
                "default": "value"
              }
            ]
          }
        },
        {
          "name": "update",
          "execute": [
            "stripe billing meters update values(meterId) --display-name values(displayName) --color off"
          ],
          "help": {
            "text": "Update a Billing Meter display name",
            "variables": [
              {
                "name": "meterId",
                "text": "Billing Meter ID",
                "arg": true
              },
              {
                "name": "displayName",
                "text": "New display name"
              }
            ]
          }
        },
        {
          "name": "deactivate",
          "execute": [
            "stripe billing meters deactivate values(meterId) --color off"
          ],
          "help": {
            "text": "Deactivate a Billing Meter",
            "variables": [
              {
                "name": "meterId",
                "text": "Billing Meter ID",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "reactivate",
          "execute": [
            "stripe billing meters reactivate values(meterId) --color off"
          ],
          "help": {
            "text": "Reactivate a Billing Meter",
            "variables": [
              {
                "name": "meterId",
                "text": "Billing Meter ID",
                "arg": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stripe:billing:meter-events",
      "commands": [
        {
          "name": "create",
          "execute": [
            "set:customerPayload=payload[stripe_customer_id]=${customerId}",
            "set:valuePayload=payload[value]=${value}",
            "stripe billing meter_events create --event-name values(eventName) --identifier values(identifier) --timestamp values(timestamp) -d values(customerPayload) -d values(valuePayload) --color off"
          ],
          "help": {
            "text": "Record a usage event for a Billing Meter",
            "variables": [
              {
                "name": "eventName",
                "text": "Billing Meter event name",
                "arg": true
              },
              {
                "name": "identifier",
                "text": "Stable unique event identifier"
              },
              {
                "name": "timestamp",
                "text": "Unix timestamp for the event"
              },
              {
                "name": "customerId",
                "text": "Stripe customer ID"
              },
              {
                "name": "value",
                "text": "Numeric usage amount"
              }
            ]
          }
        }
      ]
    }
  ]
}
